function onlyNumber(evt) {
  var charCode = (evt.which) ? evt.which : event.keyCode
   if (charCode > 31 && (charCode < 45 || charCode > 57))

	return false;
  return true;
}

function ubahJenisKelamin(jen)
{
	console.log(jen);
	if(jen === 'M')
		{
			$(".samapta_pria").removeClass("d-none");
			$(".samapta_wanita").addClass(" d-none");
		}
	else
		{
			$(".samapta_pria").addClass(" d-none");
			$(".samapta_wanita").removeClass("d-none");
		}
}

function hitungNilai()
{
    $.ajax({
        url: BASE_URL + "kalkulator/nilai_jasmani/",
        type: 'post',
        dataType: 'json',
        data: $('#form_hitung').serialize(),
        success: function(data) 
		{
			
        	if (data.success == "true") {
				console.log(data.nilai);
        		$("#nilai").val(data.nilai);
        		$("#nlari").val(data.nlari);
        		$("#npullup").val(data.npullup);
        		$("#nchinning").val(data.nchinning);
        		$("#nsitup").val(data.nsitup);
        		$("#npushup").val(data.npushup);
        		$("#nshuttlerun").val(data.nshuttlerun);
        		$("#nrenang").val(data.nrenang);
        		$("#detail_info_nilai").html(data.info);
        		$("#info_nilai").removeClass("d-none");
				
        	} else if (data.success == "false") {
        		$("#nilai").val(data.nilai);
        		$("#nlari").val(data.nlari);
        		$("#npullup").val(data.npullup);
        		$("#nchinning").val(data.nchinning);
        		$("#nsitup").val(data.nsitup);
        		$("#npushup").val(data.npushup);
        		$("#nshuttlerun").val(data.nshuttlerun);
        		$("#nrenang").val(data.nrenang);
        		$("#detail_info_nilai").html(data.info);
        		$("#info_nilai").removeClass("d-none");
        	}
        },
		error: function (jqXHR, exception) {
			var msg = '';
			if (jqXHR.status === 0) {
				msg = 'Not connect.\n Verify Network.';
			} else if (jqXHR.status == 404) {
				msg = 'Requested page not found. [404]';
			} else if (jqXHR.status == 500) {
				msg = 'Internal Server Error [500].';
			} else if (exception === 'parsererror') {
				msg = 'Requested JSON parse failed.';
			} else if (exception === 'timeout') {
				msg = 'Time out error.';
			} else if (exception === 'abort') {
				msg = 'Ajax request aborted.';
			} else {
				msg = 'Uncaught Error.\n' + jqXHR.responseText;
			}
			alert(msg);
		}
    });
}

